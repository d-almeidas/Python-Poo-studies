from rich import print
from abc import ABC, abstractmethod
from random import randint,choice
from rich.panel import Panel
from rich.table import Table

class Personagem(ABC):
    def __init__(self, nome):
        self.nome=nome
        self.vida_atual_jogador=100
        self.vida_atual_inimigo=100
        self.golpes_guerreiro=[
                      {'nome':'Espada','dano':15},
                      {'nome':'lança','dano':10},
                      {'nome':'Investida','dano':30}
                ]
        self.golpes_mago=[
                    {'nome':'Bola de fogo','dano':20},
                    {'nome':'Bola de gelo','dano':10},
                    {'nome':'Bola eletricas','dano':15}
        ]
        
    def atacar(self, alvo, forca):
        pass
    
    @abstractmethod
    def Curar(self):
        pass
    
class Guerreiro(Personagem):
    def __init__(self, nome):
        super().__init__(nome)
        
    def atacar(self, alvo, indice_golpe):
        golpe_sorteado=self.golpes_guerreiro[indice_golpe]
        forca_Do_Golpe=randint(0, golpe_sorteado['dano'])
        
        print ( f'{self.nome} tenou atacar o {alvo.nome} com {golpe_sorteado['nome']} de força {golpe_sorteado['dano']}, {alvo.nome} recebeu {forca_Do_Golpe} de dano!' )
        self.vida_atual_jogador=self.vida_atual_jogador-forca_Do_Golpe
        print(f'Vida atual de {alvo.nome}: {self.vida_atual_jogador}')
        
    def Curar(self):
        curar_quantidade=randint(0,100)
        print(f'{self.nome} curou: {curar_quantidade} de vida')
        self.vida_atual_jogador=self.vida_atual_jogador+curar_quantidade
        
class Mago(Personagem):
    def __init__(self, nome):
        super().__init__(nome)
        
    def atacar(self, alvo, forca):
        golpe_sorteado=choice(self.golpes_mago)
        forca_Do_Golpe=randint(0,forca)
        print ( f'{self.nome} tenou atacar o {alvo.nome} com {golpe_sorteado['nome']} de força {forca}, {alvo.nome} recebeu {forca_Do_Golpe} de dano!' )
        
    def Curar(self):
        curar_quantidade=randint(0,100)
        print(f'{self.nome} curou: {curar_quantidade} de vida')
                

