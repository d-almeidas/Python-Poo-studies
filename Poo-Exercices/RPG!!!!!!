class Personagem(ABC):
    def __init__(self, nome):
        self.turno_jogador=True
        self.nome=nome
        self.vida_atual=100
        self.golpes_guerreiro=[
                      {'nome':'Espada','dano':15},
                      {'nome':'lança','dano':10},
                      {'nome':'Investida','dano':30}
                ]
        self.golpes_mago=[
                    {'nome':'Bola de fogo','dano':20},
                    {'nome':'Bola de gelo','dano':10},
                    {'nome':'Bola eletricas','dano':15}
        ]
        
    def atacar(self, alvo, forca):
        pass
    
    @abstractmethod
    def Curar(self):
        pass
    
class Guerreiro(Personagem):
    def __init__(self, nome):
        super().__init__(nome)
        
    def atacar(self, alvo, indice_golpe):
        golpe_sorteado=self.golpes_guerreiro[indice_golpe]
        forca_Do_Golpe=randint(0, golpe_sorteado['dano'])
        
        print ( f'[green]{self.nome} tentou atacar o {alvo.nome} com {golpe_sorteado['nome']} de força {golpe_sorteado['dano']}, [yellow]{alvo.nome} recebeu {forca_Do_Golpe} de dano!' )
        alvo.vida_atual=alvo.vida_atual-forca_Do_Golpe
        print(f'[red]Vida atual de {alvo.nome}: {alvo.vida_atual}')
        
    def Curar(self):
        curar_quantidade=randint(0,30)
        self.vida_atual=self.vida_atual +curar_quantidade
        
        if self.vida_atual > 100:
            self.vida_atual=100
            
        print(f'{self.nome} curou: {curar_quantidade} de vida')
        
class Mago(Personagem):
    def __init__(self, nome):
        super().__init__(nome)
        
    def atacar(self, alvo, indice_golpe):
        golpe_sorteado=self.golpes_mago[indice_golpe]
        forca_Do_Golpe=randint(0,golpe_sorteado['dano'])
        print ( f'[green]{self.nome} tentou atacar o {alvo.nome} com {golpe_sorteado['nome']} de força {golpe_sorteado['dano']}, [yellow]{alvo.nome} recebeu {forca_Do_Golpe} de dano!')
        alvo.vida_atual=alvo.vida_atual-forca_Do_Golpe
        print(f'Vida atual de {alvo.nome}: {alvo.vida_atual}')
        
    def Curar(self):
        curar_quantidade=randint(0,30)
        self.vida_atual=self.vida_atual+curar_quantidade
        
        if self.vida_atual > 100:
            self.vida_atual=100
        print(f'{self.nome} curou: {curar_quantidade} de vida')
            
