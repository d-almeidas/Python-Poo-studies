def dados_De_jogo_guerreiro():
    jogador.turno_jogador=True
    
    while True:
        if jogador.turno_jogador:   
            limpar_tela()
            Painel_infos_atual()
            seu_turno=int(input('Oque deseja fazer: '))
            if seu_turno==1:
                limpar_tela()
                Tabela_Armas()
                sua_arma=int(input('Qual arma deseja usar: '))
                if sua_arma==1:
                    jogador.atacar(inimigo,0)
                if sua_arma==2:
                    jogador.atacar(inimigo,1)
                if sua_arma==3:
                    jogador.atacar(inimigo,2)
                
                input('Pressione: ENTER para continuar... ')
                
            if seu_turno==2:
                jogador.Curar()
                input('Pressione: ENTER para continuar... ')
                continue
                
            if seu_turno==3:
                Inimigo_painel_infos_Atual()
                input('Pressione: ENTER para continuar... ')
                continue
            if inimigo.vida_atual <= 0:
                inimigo.vida_atual=0
                print(f'Parabens {jogador.nome}!!!, vc derroutou a forca maligna {inimigo.nome} ')
                break
            if jogador.vida_atual <= 0:
                jogador.vida_atual=0
                print(f'Infelizmente vc foi dominado pelas forcas malignas de {inimigo.nome} ')
                break
            jogador.turno_jogador=False
            
        else:
            numero=randint(1,2)
            
            if numero==1:
                inimigo.Curar()
                jogador.turno_jogador=True
                
            if numero==2:
                golpe_aleatorio = randint(0, 2)
                inimigo.atacar(jogador, golpe_aleatorio)
                jogador.turno_jogador=True
            
            input('Pressione: ENTER para continuar... ')
            
